<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.tieringkv</groupId>
        <artifactId>tiering-kv</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>tiering-operator</artifactId>
    <name>Tiering-KV Operator</name>
    <description>Kubernetes Operator, Fabric8 Client, SaaS Governance, Compliance and DataMesh Modules</description>

    <dependencies>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-cluster</artifactId>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-cluster</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-server</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-storage</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.tieringkv</groupId>
            <artifactId>tiering-protocol</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.tieringkv.operator.TieringKVOperator</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.tieringkv.operator.TieringKVOperator</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
