# Tiering-KV Console 生产环境变量示例（O3-C）
# 使用方式：复制为 .env 并填入强随机密钥，然后执行：
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# 必填：MySQL 强口令（不可使用 root/password/123456 等弱口令）
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
CONSOLE_DB_USER=root
# MySQL 传输层 TLS 模式（PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY），生产默认 REQUIRED
MYSQL_SSL_MODE=REQUIRED

# 必填：初始管理员登录密码（至少 12 位）
CONSOLE_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# 必填：HS256 JWT 签名密钥（至少 32 字节且高随机性，推荐 openssl rand -base64 48）
CONSOLE_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_RANDOM_JWT_SECRET

# 强烈推荐：AES-256-GCM 静态加密主密钥（加密纳管实例口令与 Webhook 签名密钥，至少 16 字节）
CONSOLE_ENCRYPTION_KEY=REPLACE_WITH_STATIC_ENCRYPTION_MASTER_KEY
# 设为 true 时，生产环境未配置 CONSOLE_ENCRYPTION_KEY 将直接阻断启动
CONSOLE_REQUIRE_ENCRYPTION_IN_PROD=true

# 受信任反代网段（仅采信来自这些代理的 X-Forwarded-For）
CONSOLE_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# 可选：S3 / MinIO / RustFS 对象存储备份后端（CONSOLE_BACKUP_STORAGE=s3）
CONSOLE_BACKUP_STORAGE=local
CONSOLE_BACKUP_S3_ENDPOINT=http://minio:9000
CONSOLE_BACKUP_S3_REGION=us-east-1
CONSOLE_BACKUP_S3_BUCKET=tiering-backups
CONSOLE_BACKUP_S3_PREFIX=backups/
CONSOLE_BACKUP_S3_ACCESS_KEY=REPLACE_S3_ACCESS_KEY
CONSOLE_BACKUP_S3_SECRET_KEY=REPLACE_S3_SECRET_KEY
