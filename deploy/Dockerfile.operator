FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY deploy/maven-settings.xml /tmp/maven-settings.xml
COPY pom.xml .
COPY tiering-protocol/pom.xml tiering-protocol/pom.xml
COPY tiering-storage/pom.xml tiering-storage/pom.xml
COPY tiering-server/pom.xml tiering-server/pom.xml
COPY tiering-cluster/pom.xml tiering-cluster/pom.xml
COPY tiering-operator/pom.xml tiering-operator/pom.xml
COPY console-server/pom.xml console-server/pom.xml
COPY tiering-protocol/src tiering-protocol/src
COPY tiering-storage/src tiering-storage/src
COPY tiering-server/src tiering-server/src
COPY tiering-cluster/src tiering-cluster/src
COPY tiering-operator/src tiering-operator/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -s /tmp/maven-settings.xml -pl tiering-operator -am -q -DskipTests package
RUN set -e; \
    jar=$(ls tiering-operator/target/tiering-operator-*-shaded.jar 2>/dev/null | head -n1); \
    test -n "$jar"; \
    cp "$jar" /tmp/tiering-operator.jar

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 10001 tiering && useradd -r -u 10001 -g tiering tiering \
    && mkdir -p /app/logs && chown -R 10001:10001 /app
COPY --from=build --chown=10001:10001 /tmp/tiering-operator.jar /app/tiering-operator.jar
USER 10001:10001
EXPOSE 8088
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD /bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/8088 && printf "GET /healthz HTTP/1.0\r\n\r\n" >&3 && grep -q "200 OK" <&3'
ENTRYPOINT ["java", "-Xmx512m", "-jar", "/app/tiering-operator.jar"]
