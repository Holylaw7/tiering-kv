{
  "name": "tiering-kv-console-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "overrides": {
    "follow-redirects": "1.16.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "mermaid": "^11.17.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.1.10"
  }
}
